# ──────────────────────────
# Django
# ──────────────────────────

# Обязательно: сгенерируйте уникальное значение:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key

# Режим отладки (True/False)
DEBUG=False

# Разрешённые хосты через запятую
ALLOWED_HOSTS=127.0.0.1,localhost,example.com

# Путь к админке (обфускация)
ADMIN_URL=admin/

# Уровень логирования (DEBUG/INFO/WARNING/ERROR)
# LOG_LEVEL=INFO

# ──────────────────────────
# База данных (по умолчанию SQLite)
# ──────────────────────────

# Для PostgreSQL: DB_ENGINE=postgresql
DB_ENGINE=sqlite

# Параметры PostgreSQL (только если DB_ENGINE=postgresql)
# DB_NAME=spicesminsk
# DB_USER=spicesminsk
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONN_MAX_AGE=60

# ──────────────────────────
# Кэширование (по умолчанию LocMemCache)
# ──────────────────────────

# Для Redis: REDIS_URL=redis://redis:6379/0
# REDIS_URL=

# ──────────────────────────
# Отслеживание ошибок (Sentry)
# ──────────────────────────

# SENTRY_DSN=https://key@o0.ingest.sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ──────────────────────────
# HTTPS / Безопасность
# ──────────────────────────

# Принудительный HTTPS-редирект (только при DEBUG=False)
# SECURE_SSL_REDIRECT=True

# ──────────────────────────
# Суперпользователь (для docker-entrypoint)
# ──────────────────────────

# DJANGO_SUPERUSER_USERNAME=admin_pavel
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=changeme_pavel

# ──────────────────────────
# Gunicorn (Docker)
# ──────────────────────────

# Количество воркеров (по умолчанию: 2 * CPU + 1)
# WEB_CONCURRENCY=4
