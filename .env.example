# Обязательный параметр — сгенерируйте уникальное значение:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key

# Режим отладки (True/False)
DEBUG=False

# Разрешённые хосты через запятую
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Путь к админке (для обфускации)
ADMIN_URL=admin/

# Параметры суперпользователя (опционально, для docker-entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Принудительный HTTPS-редирект
SECURE_SSL_REDIRECT=True

# Количество воркеров gunicorn (для Docker)
WEB_CONCURRENCY=4
